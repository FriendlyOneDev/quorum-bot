TELEGRAM_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_user_id
DATABASE_URL=postgresql://user:password@host:5432/quorum

ANNOUNCEMENTS_CHAT=@YourGroupUsername
ANNOUNCEMENTS_TOPIC=1061
# Optional second mirror channel — new posts get sent to both when set.
ANNOUNCEMENTS_CHAT_ACADEMY=-100xxxxxxxxxxxx
ANNOUNCEMENTS_TOPIC_ACADEMY=2
REFRESH_INTERVAL_MINUTES=15

# --- Web frontend ---
# Signing key for Flask sessions AND magic-link tokens issued by the bot.
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
WEB_SECRET_KEY=change_me_to_random_hex
# Base URL where the web is reachable (used to build the magic-link URL).
WEB_BASE_URL=http://192.168.3.15:8080
# Bot's Telegram @username without the @ (used for the login deep link).
BOT_USERNAME=YourBotUsername
